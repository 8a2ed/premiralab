NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ─── REQUIRED in production ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-48-chars

# ─── Admin credentials (seeded on first run) ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_2026!

# ─── Storage paths ────────────────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./uploads

# ─── Email (optional — uncomment when ready) ─────────────────────────────────
# SMTP_USER=premiralab@gmail.com
# SMTP_PASS=your-google-app-password   ← Google Account → Security → App Passwords
